# Copy to .env ON THE VPS. Keep actual secrets out of Git and Docker images.
BACKEND_IMAGE=imlouiskhenghao/zxlabs:0.0.0
API_HOST=api.your-domain.com
NODE_ENV=production
PORT=3000
DATABASE_URL='postgresql://game_backend_login.PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres'
DB_TLS=true
DB_CA_FILE=/run/secrets/supabase-ca.crt
PUBLIC_BASE_URL=https://api.your-domain.com
AUTH_ISSUER=zxlabs-games
AUTH_AUDIENCE=zxlabs-games-api
AUTH_JWT_SECRET=REPLACE_WITH_32_RANDOM_BYTES_BASE64
TOKEN_ENCRYPTION_KEYS='{"v1":"REPLACE_WITH_DIFFERENT_32_RANDOM_BYTES_BASE64"}'
TOKEN_ENCRYPTION_KEY_ID=v1
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-play.json
PUBSUB_AUDIENCE=https://api.your-domain.com/webhooks/google-play
PUBSUB_SERVICE_ACCOUNT_EMAIL=YOUR_PUSH_ACCOUNT@YOUR_PROJECT.iam.gserviceaccount.com
CORS_ORIGINS=https://your-game-website.com
# One trusted reverse proxy (Caddy in this Compose). Do not expose port 3000 publicly.
TRUST_PROXY_HOPS=1
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD='YOUR_SMTP_PASSWORD'
MAIL_FROM='ZX Labs <support@zxlabs.dev>'
WORKER_POLL_MS=1000
