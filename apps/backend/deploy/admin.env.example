# Separate file, used ONLY by the one-shot admin container.
# Both URLs intentionally refer to the database owner, not the application role.
MIGRATIONS_DATABASE_URL='postgresql://postgres.PROJECT_REF:URL_ENCODED_OWNER_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres'
DATABASE_URL='postgresql://postgres.PROJECT_REF:URL_ENCODED_OWNER_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres'
DB_TLS=true
DB_CA_FILE=/run/secrets/supabase-ca.crt
RINGRUSH_ANDROID_PACKAGE=REPLACE_WITH_FINAL_ANDROID_PACKAGE
RINGRUSH_PUBSUB_SUBSCRIPTION=projects/YOUR_PROJECT/subscriptions/YOUR_RINGRUSH_SUBSCRIPTION
RINGRUSH_ENABLED=true
RINGRUSH_ALLOW_TEST_PURCHASES=false
