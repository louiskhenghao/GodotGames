NODE_ENV=development
PORT=3000
# Local PostgreSQL; production uses Supabase's direct or SESSION pooler URL.
DATABASE_URL=postgresql://iap_dev:local-dev-only@127.0.0.1:55440/iap_dev
# Migration owner connection. Keep it OUT of API/worker deployment secrets.
MIGRATIONS_DATABASE_URL=postgresql://iap_dev:local-dev-only@127.0.0.1:55440/iap_dev
DB_TLS=false
# DB_CA_FILE=/run/secrets/supabase-ca.crt
PUBLIC_BASE_URL=http://localhost:3000
AUTH_ISSUER=zxlabs-games
AUTH_AUDIENCE=zxlabs-games-api
# Generate separately: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_JWT_SECRET=REPLACE_WITH_A_RANDOM_32_BYTE_BASE64_SECRET
TOKEN_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_A_DIFFERENT_32_BYTE_BASE64_SECRET"}
TOKEN_ENCRYPTION_KEY_ID=v1
# Prefer workload identity on the deployed backend. Local alternative:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/play-service-account.json
PUBSUB_AUDIENCE=https://REPLACE-WITH-YOUR-API-HOST/webhooks/google-play
PUBSUB_SERVICE_ACCOUNT_EMAIL=REPLACE@YOUR-GCP-PROJECT.iam.gserviceaccount.com
# Explicit browser origins; native clients do not need CORS.
CORS_ORIGINS=http://localhost:8769
TRUST_PROXY_HOPS=0
# Local Mailpit captures messages; configure a real SMTP provider for production.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ZX Labs <support@zxlabs.dev>
WORKER_POLL_MS=1000
# Required before seed:ringrush; must match the final Play Console package.
RINGRUSH_ANDROID_PACKAGE=
RINGRUSH_PUBSUB_SUBSCRIPTION=
RINGRUSH_ENABLED=false
# true in the SEPARATE license-test environment; false in production.
RINGRUSH_ALLOW_TEST_PURCHASES=false
